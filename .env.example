NODE_ENV=development
HOST=0.0.0.0
PORT=4000

MARKET_PROVIDER=phoenix
SOLANA_NETWORK=mainnet-beta
SOLANA_RPC_URL=
SOLANA_WS_URL=
HELIUS_API_KEY=YOUR_KEY

PHOENIX_MARKET_IDS=
PHOENIX_PROGRAM_ID=

PHOENIX_FEES_ENABLED=false
PHOENIX_FEE_BPS=15
PHOENIX_PRO_FEE_BPS=5
PHOENIX_TREASURY_ADDRESS=

# Real order execution. EXECUTION_NETWORK defaults to devnet -- switching to mainnet-beta is a
# deliberate step that also requires a real PHOENIX_TREASURY_ADDRESS for fee collection to engage.
EXECUTION_NETWORK=devnet
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
MAX_EXECUTION_USD=50

# Free Hermes API key from a Pyth Terminal account (pythdata.app). Without it, the Pyth
# cross-check card degrades to an honest "unavailable" state rather than failing.
PYTH_API_KEY=

RECEIPTS_FILE_PATH=data/receipts.json
ALERTS_FILE_PATH=data/alerts.json

# Real Postgres persistence for receipts/alerts (survives a redeploy, unlike the file fallback
# below). Falls back to RECEIPTS_FILE_PATH/ALERTS_FILE_PATH when unset.
DATABASE_URL=

# Real tick-by-tick price history (ClickHouse Cloud "Connect" page -- host/port from there, NOT
# the account-level API key). Optional: tick recording is skipped silently when unset.
CLICKHOUSE_URL=
CLICKHOUSE_DATABASE=phoenix_lens
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Real caching for Jupiter price/stats lookups. Optional: falls back to a live fetch every time
# when unset or unreachable.
REDIS_URL=

CORS_ORIGINS=
LOG_LEVEL=info